# ─── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:5173

# ─── Base de datos (MariaDB, provider mysql) ────────────────────────────────
DATABASE_URL="mysql://examenes:examenes1234@127.0.0.1:3312/examenes_db"

# ─── JWT ────────────────────────────────────────────────────────────────────
JWT_SECRET=dev_access_secret_cambia_esto_0123456789
REFRESH_SECRET=dev_refresh_secret_cambia_esto_0123456789
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7

# ─── Seguridad ───────────────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15

# ─── Seed (admin inicial) ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@examenes.local
ADMIN_PASSWORD=admin1234
