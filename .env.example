# Variables del docker-compose (raíz).
DB_NAME=examenes_db
DB_USER=examenes
DB_PASSWORD=examenes1234
DB_ROOT_PASSWORD=root1234
DB_HOST_PORT=3312
WEB_PORT=8083

# Secretos JWT (cámbialos en producción por valores largos y aleatorios).
JWT_SECRET=cambia_esto_por_un_secreto_largo_0123456789
REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_0123456789

# Orígenes permitidos para CORS (la API; el web hace proxy /api).
CORS_ORIGINS=http://localhost:8083
